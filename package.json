{
  "name": "@opafex/knowledge-grid",
  "version": "0.1.1",
  "description": "Structured context for AI agents — a layered knowledge grid with vector indexing, domain inference, intent-driven retrieval, and token-budgeted prompt composition. Better context, better agent performance. Zero dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/opafex/knowledge-grid"
  },
  "keywords": [
    "knowledge-grid",
    "agent-context",
    "context-management",
    "rag",
    "retrieval-augmented-generation",
    "ai-agent",
    "llm-context",
    "vector-search",
    "knowledge-base",
    "llm",
    "embeddings",
    "domain-inference",
    "prompt-context",
    "prompt-builder",
    "context-window"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "node --import tsx --test src/__tests__/*.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
